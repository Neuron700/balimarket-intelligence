# Server-only. Never use NEXT_PUBLIC_ for any key below.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Backward-compatible alternative if the project still uses a legacy key:
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
GUEST_SESSION_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Choose exactly one provider. No silent provider substitution.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
XAI_API_KEY=
XAI_MODEL=
# Guest attempts per UTC day. Pricing uses 3 model calls; visual comparison uses 1.
AI_GUEST_DAILY_LIMIT=20
